            <staticText><reportElement x="500" y="0" width="55" height="36"/><box><pen lineWidth="1.0"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement><text><![CDATA[Total]]></text></staticText>
