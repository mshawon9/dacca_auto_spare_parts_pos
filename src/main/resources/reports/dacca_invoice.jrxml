            <staticText><reportElement x="210" y="0" width="80" height="36"/><box><pen lineWidth="1.0"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement><text><![CDATA[Part Number]]></text></staticText>
            <staticText><reportElement x="290" y="0" width="48" height="36"/><box><pen lineWidth="1.0"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true" size="8"/></textElement><text><![CDATA[Qty]]></text></staticText>
