            <staticText><reportElement x="365" y="170" width="82" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Payment]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement x="447" y="170" width="108" height="16"/><textFieldExpression><![CDATA[$P{P_INVOICE_PAYMENT}]]></textFieldExpression></textField>
            <staticText><reportElement x="365" y="186" width="82" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Due Date]]></text></staticText>
