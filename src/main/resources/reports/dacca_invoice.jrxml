            <textField isStretchWithOverflow="true"><reportElement stretchType="RelativeToTallestObject" x="30" y="0" width="180" height="27"/><box><pen lineWidth="1.0"/></box><textElement verticalAlignment="Middle"><font size="8"/><paragraph leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="210" y="0" width="80" height="27"/><box><pen lineWidth="1.0"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{partNumber}]]></textFieldExpression></textField>
