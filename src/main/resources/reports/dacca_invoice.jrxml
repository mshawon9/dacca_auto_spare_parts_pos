            <staticText><reportElement x="0" y="138" width="80" height="18"/><textElement><font isBold="true"/></textElement><text><![CDATA[Customer]]></text></staticText>
            <textField isBlankWhenNull="true"><reportElement x="80" y="138" width="245" height="18"/><textFieldExpression><![CDATA[$P{P_CUSTOMER_NAME}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="156" width="80" height="18"/><textElement><font isBold="true"/></textElement><text><![CDATA[TRN]]></text></staticText>
