            <textField isBlankWhenNull="true"><reportElement x="447" y="138" width="108" height="16"/><textFieldExpression><![CDATA[$P{P_INVOICE_DATE}]]></textFieldExpression></textField>
            <staticText><reportElement x="365" y="154" width="82" height="16"/><textElement><font isBold="true"/></textElement><text><![CDATA[Invoice]]></text></staticText>
